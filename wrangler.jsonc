{
	"name": "my-agent",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"vars": {
		"SHOW_MODEL": "1"
	},
	"kv_namespaces": [
		{
			"binding": "STATE",
			"id": "2183ee2f089545808c8061d52e00979d"
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *",
			"10 */6 * * *",
			"20 */6 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-agent-db",
			"database_id": "ce0fa44c-f287-4ece-9f46-fa91f125d3c1",
			"remote": true
		}
	],
	"r2_buckets": [
  {
    "binding": "FILES",
    "bucket_name": "my-agent-files"
  }
],
"ai": {
  "binding": "AI"
},
}